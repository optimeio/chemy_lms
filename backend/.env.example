# ============================================
# Environment Configuration - Chemy LMS Backend
# ============================================

# Server Configuration
PORT=5000

# MongoDB Configuration
# LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/chemy_lms
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chemy_lms
# ATLAS_DIRECT_URI=mongodb+srv+srv://username:password@cluster-direct.mongodb.net/chemy_lms

# ============================================
# EMAIL SERVICE (REQUIRED FOR PASSWORD RESET)
# ============================================
# Gmail Configuration:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Generate an App Password (16-character code)
# 5. Copy the password and use it below

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Alternative: Use environment-specific configurations
# For production, use a transactional email service like:
# - SendGrid
# - AWS SES
# - Mailgun
# - Brevo (Sendinblue)
